{
  "expo": {
    "name": "TakeSure",
    "slug": "medsync",
    "scheme": "medsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.takesure.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "TakeSure uses the camera to scan medicine strips and boxes so it can confirm the right medicine is taken.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.takesure.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F6F3"
      },
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "./plugins/withoutPushEntitlement.js",
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "TakeSure uses the camera to scan medicine strips and boxes so it can confirm the right medicine is taken."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E7A46",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "TakeSure opens your photos so you can choose a prescription to read.",
          "cameraPermission": "TakeSure uses the camera to photograph prescriptions and scan medicine strips."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "TakeSure opens your contacts only when you pick a pharmacy, to fill in its name and phone number. Nothing is uploaded."
        }
      ],
      "react-native-fast-tflite"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F6F3"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "999e4476-05a7-40c7-ba8a-ee6f8f79c8ef"
      }
    },
    "owner": "aronipanis-team"
  }
}
