{
  "expo": {
    "name": "DoseSure",
    "slug": "medsync",
    "scheme": "medsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.medsync.family",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "DoseSure uses the camera to scan medicine strips and boxes so it can confirm the right medicine is taken."
      }
    },
    "android": {
      "package": "com.medsync.family",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F6F3"
      }
    },
    "plugins": [
      "./plugins/withoutPushEntitlement.js",
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "DoseSure uses the camera to scan medicine strips and boxes so it can confirm the right medicine is taken."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E7A46",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "DoseSure opens your photos so you can choose a prescription to read.",
          "cameraPermission": "DoseSure uses the camera to photograph prescriptions and scan medicine strips."
        }
      ],
      "react-native-fast-tflite"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F6F3"
    }
  }
}
